# Primary WhatsApp contact number in international format without plus or spaces (e.g. 263781977976)
VITE_WHATSAPP_NUMBER=263781977976

# Secondary WhatsApp contact number in international format
VITE_WHATSAPP_NUMBER_SECONDARY=263783480821

# Canonical base URL for production deployment
VITE_SITE_URL=https://premier.hakili.online

# Password required to unlock the protected preview site (set in Vercel project env vars)
SITE_LOCK_PASSWORD=change-me

# Random 32-byte hex secret used to sign the HttpOnly unlock cookie (set in Vercel project env vars)
SITE_LOCK_SECRET=replace-with-32-byte-random-hex
